# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# offline OCR engine (copied from node_modules by `npm run ocr`, also part of `npm run build`)
/public/ocr/

# launch video workspace: dependencies, captured screens and renders are all regenerable
/promo/node_modules/
/promo/out/
/promo/public/screens/
/promo/public/fonts/

# capacitor native builds (generated by `npx cap add`)
/android/app/build
/ios/App/Pods
/ios/App/build

# generated audit report (npm run audit)
/audit.json
.vercel
.env*

# Native signing. A keystore or its passwords in the repository would let
# anyone publish an update as Owwy.
/android/keystore.properties
*.jks
*.keystore
/android/app/release
/android/.gradle
/android/local.properties

# The web build copied into the native shells by `npx cap sync`. It is 17MB
# of generated output that `npm run cap:sync` recreates in a second.
/android/app/src/main/assets/public
/ios/App/App/public
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
