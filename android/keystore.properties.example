# Copy to android/keystore.properties and fill in. That file is gitignored:
# a keystore or its passwords in the repository would let anyone publish an
# update as Owwy.
#
# Make the keystore once and keep it safe forever — Play ties your app to it,
# and losing it means you cannot update your own app:
#   keytool -genkey -v -keystore owwy-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias owwy
storeFile=../owwy-release.jks
storePassword=
keyAlias=owwy
keyPassword=
