# Vercel uses this file INSTEAD of .gitignore, so it has to be complete —
# anything missing here starts getting uploaded.

# dependencies and build output (Vercel installs and builds these itself)
node_modules
.next
out
build
coverage

# generated by the build: scripts/copy-ocr.mjs refills it on Vercel
public/ocr

# the marketing site is its own Vercel project (root directory: site)
site

# the launch-video workspace — 800MB of Remotion, Puppeteer and renders,
# none of which the app needs to build
promo

# native shells, produced by `npx cap add`
android
ios

# local tooling and reports
.claude
audit.json
tests

# env and secrets
.env*
*.pem

# misc
.DS_Store
*.tsbuildinfo
npm-debug.log*
