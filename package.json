{
  "name": "owwy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-ocr.mjs && next build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "preview:headers": "node scripts/serve.mjs --headers",
    "audit": "node scripts/audit.mjs",
    "site": "node scripts/serve.mjs --root=site --port=4180",
    "audit:site": "node scripts/audit-site.mjs",
    "og": "node scripts/make-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "ocr": "node scripts/copy-ocr.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@capacitor/app": "^8.1.1",
